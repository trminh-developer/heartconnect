# Localhost, LAN and Dev Tunnels use the frontend server's /api proxy.
# Vercel uses the /api rewrite in vercel.json.
VITE_API_URL=/api

# Used by Vite dev/preview only. Keep this server-side variable without VITE_.
API_PROXY_TARGET=http://127.0.0.1:3000

# On Firebase/static hosting without an API rewrite, use the HTTPS backend URL:
# VITE_API_URL=https://heartconnect-api.vercel.app/api
