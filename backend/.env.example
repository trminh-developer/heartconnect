PORT=3000
USE_MOCK_DB=true
DATABASE_TYPE=mock
# Mock is the default. MySQL requires USE_MOCK_DB=false (or DATABASE_TYPE=mysql) plus DATABASE_URL.
# Hosted PostgreSQL: set USE_MOCK_DB=false, DATABASE_TYPE=postgres and DATABASE_URL.
# postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# DATABASE_SSL_CA can contain the provider's PEM root CA (literal \\n is accepted).
# Aiven PostgreSQL requires the project CA from its Overview page in production.
# Set DATABASE_SSL_CA in the backend hosting environment, not in VITE_* variables.
DATABASE_SSL_CA=
# Mock mode also works with NODE_ENV=production and ignores any old DATABASE_URL.
# Render Free can use SQLITE_STORAGE=/tmp/heartconnect.sqlite (data resets on redeploy).
# Default: the OS temp directory in production, backend/Database/dating_app.sqlite locally.
# SQLITE_STORAGE=/tmp/heartconnect.sqlite
PAYMENT_MODE=sandbox
# direct: the three supplied BIDV QR codes, reconciled by an administrator.
# sepay: signed hosted checkout, verified with the SePay Payment Gateway API/IPN.
BANK_PAYMENT_MODE=direct
SEPAY_ENV=sandbox
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
# Optional separate IPN secret. Configure SePay IPN auth type SECRET_KEY with this value.
# When empty, the merchant secret is used for X-Secret-Key verification.
SEPAY_IPN_SECRET=
# IPN endpoint: <public BACKEND_URL>/api/payments/sepay/ipn
# For local development, keep merchant credentials in the Git-ignored backend/.env.local.
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Additional frontend origins, separated by commas (include custom production domains).
CORS_ORIGINS=

# Discover: bounded retrieval across interests, activity and new profiles.
DISCOVERY_CANDIDATE_BATCH_SIZE=500
DISCOVERY_MAX_CANDIDATES=1500

# VNPAY SANDBOX
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Configure VNPay IPN in the merchant portal: <public BACKEND_URL>/api/payments/vnpay/ipn

# MOMO SANDBOX
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
# Return URL is generated from BACKEND_URL: /api/payments/momo/return
MOMO_IPN_URL=https://YOUR_NGROK_ID.ngrok.app/api/payments/momo/ipn

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe webhook: <public BACKEND_URL>/api/payments/stripe/webhook
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
